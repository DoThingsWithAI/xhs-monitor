{
  "name": "xhs-monitor",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev apps/web -H 0.0.0.0",
    "build": "next build apps/web --webpack",
    "start": "next start apps/web -H 0.0.0.0",
    "worker": "tsx apps/worker/index.ts",
    "db:init": "tsx packages/db/migrate.ts",
    "admin:init": "tsx scripts/admin-init.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "worker:smoke": "tsx scripts/worker-smoke.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "next": "^16.0.0",
    "playwright": "1.64.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}
