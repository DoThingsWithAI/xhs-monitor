# XHS Monitor: private VPS configuration (copy to .env; never commit .env)
# Host directory persisted across compose rebuilds; must match bind mount in deploy/compose.yaml.
XHS_DATA_DIR=/var/lib/xhs-monitor

# Domain used by Caddy; set to a real DNS name pointing at your VPS before deploying.
APP_DOMAIN=CHANGE_ME

# Future web application settings; deployment script generates SESSION_SECRET on first prepare.
NODE_ENV=production
TZ=Asia/Shanghai

# When application authentication is implemented, use its documented secure admin setup flow.
# Do NOT put plaintext administrator passwords into this file or GitHub.

# Daily automatic GitHub pull + Compose deployment at 08:00 in this timezone.
# This is the application deployment schedule, NOT the product collection interval.
# Safe default: China Standard Time even when Ubuntu host timezone is UTC.
AUTO_DEPLOY_TIMEZONE=Asia/Shanghai

# Only applies to data sources with verified automated-access permission.
# Seconds between individual products' requests, measured after the previous visit completes.
# Default 120s. Enforced range: 60..3600s. Longer intervals cost more total processing time.
# Rate limiting does not grant access or guarantee that a site will permit crawling.
XHS_SOURCE_MIN_GAP_SECONDS=120
